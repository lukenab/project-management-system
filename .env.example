# Docker Compose only. Copy to .env to change a default; without it the defaults in
# docker-compose.yml are used. Never commit the real .env.

MONGO_USERNAME=root
MONGO_PASSWORD=change-me
ME_USERNAME=admin
ME_PASSWORD=change-me

# Signs the access tokens: any long random string (e.g. `openssl rand -hex 32`).
SECRET=change-me

# Host ports: the site (Google only allows http://localhost:3000) and the API.
FRONTEND_PORT=3000
BACKEND_PORT=3003
# Address of the site, used in password-reset links.
APP_URL=http://localhost:3000

# Needed to send registration and password-reset emails (https://resend.com).
# With the test sender onboarding@resend.dev, Resend only delivers to its owner's email.
RESEND_API_KEY=
MAIL_FROM=

# Public OAuth client ID (Google Cloud Console). Leave empty to use the compose default.
GOOGLE_CLIENT_ID=
