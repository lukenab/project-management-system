# Copy to .env and change the values. .env is not committed.
# Used by docker-compose.yml

MONGO_USERNAME=admin
MONGO_PASSWORD=
MONGO_DB=project_management_dev
# JWT secret of the backend container (create test tokens with the same value)
JWT_SECRET=

# Ports on your machine; change them if they are already taken
# (a local MongoDB usually uses 27017)
BACKEND_PORT=3000
FRONTEND_PORT=3001
MONGO_PORT=27017

# Only used by: docker compose --profile tools up -d
ME_USERNAME=admin
ME_PASSWORD=
