# Running the backend without Docker (npm run dev). Copy to .env.
PORT=3003
TEST_MONGODB_URI=mongodb://localhost:27017/project_management_dev

# Signs the access tokens: any long random string.
SECRET=change-me

# Registration and password-reset emails. Without RESEND_API_KEY the email is printed
# to the console instead (development only).
RESEND_API_KEY=
MAIL_FROM=

# Public OAuth client ID (Google Cloud Console).
GOOGLE_CLIENT_ID=
