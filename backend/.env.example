# Copy to backend/.env and change the values. .env is not committed.
# Used when the backend runs outside Docker

PORT=3000
# Same value as JWT_SECRET of the Docker backend when you test against it
SECRET=change-me
# Database for development and tests
# Docker MongoDB: mongodb://<MONGO_USERNAME>:<MONGO_PASSWORD>@127.0.0.1:<MONGO_PORT>/<MONGO_DB>?authSource=admin
# MongoDB without a password: mongodb://127.0.0.1:27017/project_management_dev
TEST_MONGODB_URI=mongodb://admin:change-me@127.0.0.1:27017/project_management_dev?authSource=admin
